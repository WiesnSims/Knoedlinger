[gd_resource type="Resource" script_class="VoiceLineSet" format=3]

[ext_resource type="Script" path="res://scripts/data/voice_line_set.gd" id="1_set"]
[ext_resource type="Script" path="res://scripts/data/voice_line_data.gd" id="2_line"]

[sub_resource type="Resource" id="line_0"]
script = ExtResource("2_line")
text_key = "VOICE_PERCHTE_HOE"
sound = &"voice_perchte_hoe"

[sub_resource type="Resource" id="line_1"]
script = ExtResource("2_line")
moment = 1
text_key = "VOICE_PERCHTE_KIMMST"
sound = &"voice_perchte_kimmst"

[sub_resource type="Resource" id="line_2"]
script = ExtResource("2_line")
moment = 2
text_key = "VOICE_PERCHTE_SCHELLN"
sound = &"voice_perchte_schelln"

[resource]
script = ExtResource("1_set")
lines = Array[ExtResource("2_line")]([SubResource("line_0"), SubResource("line_1"), SubResource("line_2")])
