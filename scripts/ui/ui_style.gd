class_name UiStyle
extends RefCounted
## Shared helpers for every screen (docs/UI-STYLE.md). The look itself lives in ui/theme.tres
## (generated by tools/ui/make_theme.gd): nodes pick it with `theme_type_variation`, custom-drawn
## widgets read the "Palette" colours from it. No per-node theme overrides.

const THEME_PATH: String = "res://ui/theme.tres"
const ICON_GOLD: String = "res://assets/icons/trinkgeld.svg"
const ICON_HEAL: String = "res://assets/icons/gulasch.svg"
## Motion (docs/UI-STYLE.md, "Motion"), in seconds.
const T_PANEL_IN: float = 0.18
const T_STAGGER: float = 0.06
const T_HOVER: float = 0.1
const T_PANEL_OUT: float = 0.12
const T_BAR: float = 0.25
const HOVER_SCALE: float = 1.03

static var _theme: Theme


static func theme() -> Theme:
	if _theme == null:
		_theme = load(THEME_PATH)
	return _theme


## A palette colour ("accent", "danger", "rarity_2" ...).
static func color(name: String) -> Color:
	return theme().get_color(name, "Palette")


static func font(name: String) -> Font:
	return theme().get_font(name, "Palette")


static func font_size(name: String) -> int:
	return theme().get_font_size(name, "Palette")


static func rarity_color(rarity: int) -> Color:
	return color("rarity_%d" % clampi(rarity, 0, 3))


## "CardRarity2", "TileEvolution" ...: the variation whose border shows the card's rarity.
static func rarity_variation(prefix: String, card: Card) -> StringName:
	if card.kind == Card.Kind.EVOLUTION:
		return StringName(prefix + "Evolution")
	return StringName("%sRarity%d" % [prefix, clampi(card.rarity, 0, 3)])


static func label(variation: StringName = &"", text: String = "") -> Label:
	var node := Label.new()
	node.theme_type_variation = variation
	node.text = text
	node.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return node


static func panel(variation: StringName = &"") -> PanelContainer:
	var node := PanelContainer.new()
	node.theme_type_variation = variation
	node.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return node


static func vbox(variation: StringName = &"") -> VBoxContainer:
	var node := VBoxContainer.new()
	node.theme_type_variation = variation
	node.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return node


static func hbox(variation: StringName = &"") -> HBoxContainer:
	var node := HBoxContainer.new()
	node.theme_type_variation = variation
	node.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return node


static func bar(variation: StringName) -> ProgressBar:
	var node := ProgressBar.new()
	node.theme_type_variation = variation
	node.show_percentage = false
	node.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return node


## A full-screen centre container under `root`.
static func centred(root: Control) -> CenterContainer:
	var centre := CenterContainer.new()
	centre.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	centre.mouse_filter = Control.MOUSE_FILTER_IGNORE
	root.add_child(centre)
	return centre


## The UI root of a CanvasLayer: full screen, themed, lets the mouse through.
static func root(layer: CanvasLayer) -> Control:
	var node := Control.new()
	node.set_anchors_preset(Control.PRESET_FULL_RECT)
	node.mouse_filter = Control.MOUSE_FILTER_IGNORE
	node.theme = theme()
	layer.add_child(node)
	return node


static func card_icon(card: Card, catalog: UpgradeCatalog) -> Texture2D:
	match card.kind:
		Card.Kind.WEAPON, Card.Kind.EVOLUTION:
			return catalog.weapons[card.index].icon
		Card.Kind.PASSIVE:
			return catalog.passives[card.index].icon
		Card.Kind.ITEM:
			return catalog.items[card.index].icon
		Card.Kind.GOLD:
			return load(ICON_GOLD)
	return load(ICON_HEAL)


## Highest level of the card's item (0 = open-ended, and for gold and heal, which have none).
static func card_max_level(card: Card, catalog: UpgradeCatalog) -> int:
	match card.kind:
		Card.Kind.PASSIVE:
			return catalog.passives[card.index].max_level
	return 0


static var _atlas: Dictionary[Texture2D, AtlasTexture] = {}


## The icons of a catalog packed into one texture (plus the fallback cards'), so the HUD draws all
## of them in one canvas batch instead of one draw call per icon. Call once per run.
static func build_icon_atlas(catalog: UpgradeCatalog) -> void:
	var icons: Array[Texture2D] = []
	for weapon: WeaponData in catalog.weapons:
		if weapon.icon != null and not icons.has(weapon.icon):
			icons.append(weapon.icon)
	for passive: PassiveData in catalog.passives:
		if passive.icon != null and not icons.has(passive.icon):
			icons.append(passive.icon)
	for item: ItemData in catalog.items:
		if item.icon != null and not icons.has(item.icon):
			icons.append(item.icon)
	for path: String in [ICON_GOLD, ICON_HEAL]:
		icons.append(load(path))
	if icons.is_empty():
		return
	var cell: int = icons[0].get_width()
	var columns: int = ceili(sqrt(icons.size()))
	var sheet := Image.create_empty(columns * cell, ceili(float(icons.size()) / columns) * cell, false, Image.FORMAT_RGBA8)
	var placed: Array[Rect2] = []
	for k: int in icons.size():
		var image: Image = icons[k].get_image()
		image.convert(Image.FORMAT_RGBA8)
		if image.get_width() != cell or image.get_height() != cell:
			image.resize(cell, cell, Image.INTERPOLATE_LANCZOS)
		var at := Vector2i((k % columns) * cell, (k / columns) * cell)
		sheet.blit_rect(image, Rect2i(Vector2i.ZERO, Vector2i(cell, cell)), at)
		placed.append(Rect2(at, Vector2(cell, cell)))
	var texture := ImageTexture.create_from_image(sheet)
	_atlas.clear()
	for k: int in icons.size():
		var region := AtlasTexture.new()
		region.atlas = texture
		region.region = placed[k]
		_atlas[icons[k]] = region


## The atlas version of an icon (the icon itself until the atlas is built).
static func atlas_icon(icon: Texture2D) -> Texture2D:
	return _atlas.get(icon, icon)


static func icon_rect(texture: Texture2D, edge: float) -> TextureRect:
	var rect := TextureRect.new()
	rect.texture = atlas_icon(texture)
	rect.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	rect.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	rect.custom_minimum_size = Vector2(edge, edge)
	rect.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return rect
